<h1>Songs</h1>
<div class="row">
    <div class="container">
        <%= form_with url: "/songs/search", method: :get do |form| %>
            <%= form.label :query, "Search for:" %>
            <%= form.search_field :query %>
            <%= form.submit "Search" %>
        <% end %>
    </div>
</div>
<% @var.each do |var| %>
    <div class="row">
        <div class="songDiv">        
            <h3><b><%= var.name %></b> by, <%= var.author %></h3>
            <h3><%= var.desc %></h3> 
        </div>    
    </div>
<% end %>
