<%= form_with model: @song do |form| %>
    <div class="row">
        <%= form.label :name %>
        <%= form.text_field :name %>
    </div>
    <div class="row">
        <%= form.label :author %>
        <%= form.text_field :author %>
    </div>
    <div class="row">
        <%= form.label :desc %>
        <%= form.text_field :desc %>
    </div>
    <div class="row">
        <%= form.label :featured_image %>
        <%= form.file_field :featured_image, accept: "image/*" %>
    </div>
    <div class="row">
        <%= form.label :featured_audio %>
        <%= form.file_field :featured_audio, accept: "audio/*" %>
    </div>
    <div class="row">
        <%= form.submit %>
    </div>
<% end %>

